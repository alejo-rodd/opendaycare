{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/gpt-6-luna",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--output-dir",
          ".playwright-mcp"
        ]
      }
    }
  }
}
